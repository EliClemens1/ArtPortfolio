import { addDoc, collection } from "https://www.gstatic.com/firebasejs/12.11.0/firebase-firestore.js";
import { db } from "./firebase_config.js";

export async function addOceanFoam() {
    const artwork = {
        title: "Ocean Foam",
        artist: "E Like Lemons",
        date: "2024",
        medium: "Watercolor",
        longDescription: "This whimsical digital painting captures the hilarity and chaos of a cat unexpectedly finding itself in a bathtub.",
        dimensions: "24 x 36 in",
        image: "placeholderImages/wetCat.jpg",
        extraImages: []
    };

    try {
        const docRef = await addDoc(collection(db, "artworks"), artwork);
        console.log("Ocean Foam added with ID:", docRef.id);
    } catch (error) {
        console.error("Error adding Ocean Foam:", error);
    }
}